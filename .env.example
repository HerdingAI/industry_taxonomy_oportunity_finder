# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Tavily API for web research (recommended for better results)
TAVILY_API_KEY=your_tavily_api_key_here

# Model Configuration
OPENROUTER_MODEL=openrouter/sherlock-think-alpha

# PostgreSQL RAG Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=meetup_events
PG_USER=meetup_app
PG_PASSWORD=your_postgres_password_here
